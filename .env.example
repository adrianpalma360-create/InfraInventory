# ==============================================================================
# InfraInventory - Environment Variables Configuration Template
# ==============================================================================
# Copia este archivo a .env antes de iniciar la aplicación en producción.
# Si despliegas con Portainer, configura estas variables en la sección Environment.
# ==============================================================================

# 👤 Configuración de Contenedores en GitHub Container Registry (GHCR)
# Define el usuario o namespace de GitHub donde se alojan las imágenes del proyecto
GHCR_NAMESPACE=adrianpalma360-create

# 🏷️ Tag de Imagen Docker a desplegar (ej. 'latest', '11.0.0', '11.0.1', etc.)
IMAGE_TAG=latest

# 🌐 Puerto HTTP de Acceso Web (expuesto en el servidor host)
HTTP_PORT=3000

# 🐘 Base de Datos PostgreSQL (Interna en la red Docker, no exponer el puerto 5432)
POSTGRES_DB=infrainventory_db
POSTGRES_USER=infrainventory_user
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_DB_PASSWORD

# 🔐 Claves Criptográficas de Sesión y Tokens JWT (Longitud recomendada >= 32 caracteres)
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
COOKIE_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_COOKIE_SECRET_AT_LEAST_32_CHARS

# 🌍 Dominios Permitidos para CORS (Separados por comas, o * para permitir cualquier origen)
CORS_ORIGIN=*

# 🤖 Inteligencia Artificial & Diagnóstico Local Asistido (Opcional)
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_MODEL=llama3:8b
AI_API_KEY=
